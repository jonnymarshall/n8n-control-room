# Secrets
.env
.env.*
!.env.example
client/.env

# Local state written by deploy scripts
.public-api-workflow-id

# Claude Code per-user state (not shared)
.claude/settings.local.json

# Playwright MCP browser session dumps (local only)
.playwright-mcp/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Node (in case we add tooling later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local n8n sync baselines (used by the manual-edit guard hook)
.claude/n8n-sync-state.json

# Python bytecode (hooks)
.claude/hooks/__pycache__/
**/__pycache__/

# Local scratch / temp work (session notes, build scraps)
tmp/
