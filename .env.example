# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is committed as a template.
# === Required for every script ===
# The base URL of your n8n instance (no trailing slash).
N8N_URL=

# N8N Instance-level MCP Access Token
N8N_MCP_ACCESS_TOKEN=

# n8n API keys
# === Required for any deploy/* or query/* script that talks to n8n's REST API ===
N8N_API_KEY=

# === Required for n8n backups
N8N_API_SELF_V05=

# === AgentMail (only for scripts that touch AgentMail) ===
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_CREDENTIAL_ID=

# === Reserved / future use (no current script reads these) ===
# Calendly is no longer used by the content pipeline: scheduling is email-driven
# via AgentMail. Kept in case they're useful later.
N8N_V3=
CALENDLY_CREDENTIAL_ID=

# === API - Agent Token (for running queries, specific to user) ===
# Generate with the 'issue.sh' script
AGENT_TOKEN=

# AIRTABLE
AIRTABLE_PAT_TOKEN=

# === Telegram (chat ID for personal bot DM, used by scripts and referenced in workflow READMEs) ===
# Name must be a valid shell identifier (letters/digits/underscore) or the deploy-script
# .env loader aborts and can echo the value to the terminal.
TELEGRAM_USER_CHAT_ID=

# === Telegram (chat ID for the Pod21 / Guy's Take group, referenced in workflow READMEs) ===
TELEGRAM_GROUP_CHAT_ID_POD21=

# === Telegram Bot Token (pod21_n8n_agent_bot)
TELEGRAM_BOT_TOKEN=

# Github
n8n_backups_bot=

# Google
pod21_n8n_api_key=

# Google (temporary, to be switched to pod21_n8n_api_key)
pod21_n8n_temp=

# Frame.io
N8N_ALL_SCOPES=